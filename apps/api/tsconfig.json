{
  "extends": "@repo/typescript-config/bun.json",
  "compilerOptions": {
    // `node` fournit les types de `process` (utilisé pour PORT et CORS_ORIGIN),
    // que Bun expose aussi. Déclaré en dépendance directe : Vercel n'installe
    // pas les dépendances transitives de ce workspace.
    // Pas d'alias ici : Vercel construit le lambda en traçant les imports, et
    // un traceur ne suit que les chemins relatifs et les paquets de
    // node_modules. Derrière un alias (`paths` ou `imports`), les fichiers
    // visés ne sont jamais embarqués et la Function crashe au démarrage.
    "types": ["bun", "node"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
