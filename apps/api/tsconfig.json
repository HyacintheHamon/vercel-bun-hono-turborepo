{
  "extends": "@repo/typescript-config/bun.json",
  "compilerOptions": {
    // `node` fournit les types de `process` (utilisé pour PORT et CORS_ORIGIN),
    // que Bun expose aussi. Déclaré en dépendance directe : Vercel n'installe
    // pas les dépendances transitives de ce workspace.
    //
    // Alias `@/x` → `src/x`, comme dans apps/web. Ils sont résolus au build par
    // le mode expérimental de Vercel (`VERCEL_EXPERIMENTAL_BACKENDS`, activé
    // dans vercel.json), qui les réécrit en chemins relatifs avant déploiement.
    "types": ["bun", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
